# ═══════════════════════════════════════════════════════
#  MS HARMONY FRONTEND - ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════
# Copy file ini ke .env lalu sesuaikan nilainya.
# Vite mengekspos env vars yang diawali VITE_ ke client-side.
# JANGAN taruh secret/API key di sini — ini ter-bundle ke browser.

# ─── API ──────────────────────────────────────────────
VITE_API_BASE_URL=/api
VITE_BACKEND_URL=http://localhost:5000

# ─── Branding ─────────────────────────────────────────
VITE_APP_NAME=MS Harmony
VITE_APP_TAGLINE=Premium Kebaya Rental
VITE_APP_DESCRIPTION=Koleksi kebaya premium untuk momen istimewa Anda. Sewa mudah, harga terjangkau, kualitas terbaik di Yogyakarta.

# ─── Kontak & Alamat ─────────────────────────────────
VITE_CONTACT_WHATSAPP=0812-xxxx-xxxx
VITE_CONTACT_EMAIL=info@msharmony.com
VITE_CONTACT_INSTAGRAM=@msharmony.kebaya
VITE_STUDIO_ADDRESS=Studio MS Harmony, Yogyakarta

# ─── Payment ─────────────────────────────────────────
VITE_PAYMENT_POLL_INTERVAL=5000
VITE_CHAT_POLL_INTERVAL=3000

# ─── Dev Server ──────────────────────────────────────
VITE_PORT=5173
